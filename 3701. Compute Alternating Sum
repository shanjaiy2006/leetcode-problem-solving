class Solution {
    public int alternatingSum(int[] nums) {
        int n = nums.length;
        boolean even = true;
        int sum = 0;
        for(int i=0;i<n;i++) {
            if(even) {
                sum += nums[i];
            }
            else {
                sum -= nums[i];
            }
            even = !even;
        }
        return sum;
    }
}
