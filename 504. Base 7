class Solution {
    public String convertToBase7(int num) {
        if(num == 0) {
            return "0";
        }
        boolean isNegative = num < 0;
        num = Math.abs(num);
        StringBuilder res = new StringBuilder();
        while(num > 0) {
            int remainder = num % 7;
            res.append(remainder);
            num = num / 7;
        }
        if(isNegative) {
            res.append("-");
        }
        return res.reverse().toString();
    }
}
