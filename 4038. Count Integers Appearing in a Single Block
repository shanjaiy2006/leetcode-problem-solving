class Solution {
    public int countSpecialIntegers(int[] nums) {
        int blocks[] = new int[101];
        for(int i=0;i<nums.length;i++) {
            if(i==0 || nums[i]!=nums[i-1]) {
                blocks[nums[i]]++;
            }
        }
        int res = 0;
        for(int val : blocks) {
            if(val == 1) {
                res++;
            }
        }
        return res;
    }
}
