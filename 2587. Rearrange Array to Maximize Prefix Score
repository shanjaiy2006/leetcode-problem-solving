class Solution {
    public int maxScore(int[] nums) {
        int n = nums.length;

        Arrays.sort(nums);
        int score = 0;
        long prefix = 0;
        for(int i=n-1;i>=0;i--) {
            prefix += nums[i];
            if(prefix > 0) {
                score++;
            }
        }
        return score;
    }
}
